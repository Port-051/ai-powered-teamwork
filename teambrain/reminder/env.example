# 리마인드 알림 설정 예시.
#
# 쓰는 법: 이 파일을 레포 맨 위 폴더에 `.env` 로 복사해서 값을 채운다.
#   cp teambrain/reminder/env.example .env
#
# ⚠️ 토큰 값은 Claude 대화창에 붙여넣지 말고 편집기로 이 파일에 직접 넣는다.
#    (대화 내용은 log/raw/ 로 자동 커밋·푸시된다 — CLAUDE.md 참고)
#    `.env` 는 .gitignore 에 있어서 GitHub 에 올라가지 않는다.

# ── 방법 B: 봇 토큰 (권장 — 채널 여러 개 + 멘션으로 등록 가능) ──────────────
# OAuth & Permissions → Install to Workspace 후 발급되는 값
SLACK_BOT_TOKEN=xoxb-여기에-봇-토큰
# Basic Information → App-Level Tokens (scope: connections:write) — `bot` 명령에만 필요
SLACK_APP_TOKEN=xapp-여기에-앱-토큰

# ── 방법 A: Incoming Webhook (제일 쉬움 — 채널 하나로만 발송) ───────────────
# 위 봇 토큰이 있으면 그쪽이 우선 사용된다. 둘 중 하나만 채우면 된다.
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# 기본 채널 ID (--to 없이 add 할 때 사용). 슬랙 채널명 클릭 → 맨 아래 C0... 값
SLACK_DEFAULT_CHANNEL=C0XXXXXXXXX

# ── 선택 설정 (안 넣으면 아래 기본값) ──────────────────────────────────────
#REMINDER_DB_PATH=~/.teambrain/reminders.db
#REMINDER_TIMEZONE=Asia/Seoul
#REMINDER_POLL_SECONDS=20
#REMINDER_MAX_ATTEMPTS=5
